#
# The PhosphorEngineLibs package: the installed phosphor-engine-libs, for a
# consumer that links the packaged libraries instead of building the pinned
# archive in its own tree.
#
#   find_package(PhosphorEngineLibs 0.1 REQUIRED COMPONENTS PhosphorEngine PhosphorZones)
#
# Each component is the CMake package of one library (PhosphorZones gives
# PhosphorZones::PhosphorZones). The package also sets
# PHOSPHOR_ENGINE_LIBS_DATA_DIR to the installed layouts, algorithms and
# scrolling templates, the same variable an in-tree phosphor-engine-libs sets.

@PACKAGE_INIT@

set_and_check(PHOSPHOR_ENGINE_LIBS_DATA_DIR "@PACKAGE_PHOSPHOR_ENGINE_LIBS_DATA_INSTALL_DIR@")
set(PHOSPHOR_ENGINE_LIBS_INSTALLED TRUE)

# The library packages are installed beside this one, in the same release.
get_filename_component(_phosphor_engine_libs_packages "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
foreach(_phosphor_engine_libs_component IN LISTS PhosphorEngineLibs_FIND_COMPONENTS)
    find_package(${_phosphor_engine_libs_component} CONFIG QUIET
                 PATHS "${_phosphor_engine_libs_packages}" NO_DEFAULT_PATH)
    set(PhosphorEngineLibs_${_phosphor_engine_libs_component}_FOUND ${${_phosphor_engine_libs_component}_FOUND})
endforeach()
unset(_phosphor_engine_libs_component)
unset(_phosphor_engine_libs_packages)

check_required_components(PhosphorEngineLibs)
